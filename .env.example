# Copy to .env.local and fill in from Supabase: Project Settings > API Keys.
# Leave these empty to run the app with no accounts (fully offline).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: where the TV page is hosted, e.g. https://game-night.expo.app/tv.
# The phone shows this address when linking a TV.
EXPO_PUBLIC_TV_URL=
